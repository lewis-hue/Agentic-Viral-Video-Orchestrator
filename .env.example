# AVVO configuration - copy to .env and fill in real values. Never commit .env.

# LLM providers
OPENAI_API_KEY=your_openai_key_here
ANTHROPIC_API_KEY=your_anthropic_key_here

# Database
DATABASE_URL=postgresql://user:password@localhost/avvo_db

# Vector DB
FAISS_INDEX_PATH=./data/faiss_index

# Platform APIs
TIKTOK_API_KEY=your_tiktok_key
YOUTUBE_API_KEY=your_youtube_key
INSTAGRAM_API_KEY=your_instagram_key

# Video Generation
SORA_API_KEY=your_sora_key
GOOGLE_CLOUD_API_KEY=your_google_cloud_api_key  # For Gemini and Veo
GEMINI_API_KEY=your_gemini_api_key
RUNWAY_API_KEY=your_runway_key
ELEVENLABS_API_KEY=your_elevenlabs_key
SUNO_API_KEY=your_suno_key

# Monitoring
LANGCHAIN_API_KEY=your_langchain_key
DATADOG_API_KEY=your_datadog_key

# Zapier and Buffer Integration
ZAPIER_WEBHOOK_URL=your_zapier_webhook_url
YOUTUBE_PROFILE_ID=your_youtube_profile_id
INSTAGRAM_PROFILE_ID=your_instagram_profile_id
TIKTOK_PROFILE_ID=your_tiktok_profile_id

# Media Upload for Public URLs
MEDIA_UPLOAD_SERVICE=cloudinary  # Options: cloudinary, s3, etc.
CLOUDINARY_URL=cloudinary://api_key:api_secret@cloud_name
AWS_S3_BUCKET=your_s3_bucket
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
