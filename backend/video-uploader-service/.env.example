# AVVO Multi-Platform Video Uploader - Environment Configuration
2# Copy this file to .env and fill in your actual credentials

# ========================================
# SERVER CONFIGURATION
# ========================================

# Host and port for the FastAPI server
HOST=0.0.0.0
PORT=8000

# Debug mode (set to false in production)
DEBUG=true

# Log level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# ========================================
# INSTAGRAM GRAPH API CONFIGURATION
# ========================================

# Instagram Business/Creator Account Credentials
# Requirements:
# - Instagram Business or Creator account connected to Facebook Page
# - Facebook Developer App with Instagram Basic Display product
# - Required scopes: instagram_basic, instagram_content_publish, pages_read_engagement, pages_manage_posts

# Your Instagram Access Token (long-lived, with required scopes)
INSTAGRAM_ACCESS_TOKEN=your_instagram_access_token_here

# Your Instagram User ID (numeric ID, not username)
IG_USER_ID=your_instagram_user_id_here

# ========================================
# FACEBOOK GRAPH API CONFIGURATION
# ========================================

# Facebook Page Credentials
# Requirements:
# - Facebook Page with video posting permissions
# - Facebook Developer App
# - Required scopes: pages_read_engagement, pages_manage_posts, pages_read_user_content, pages_manage_metadata

# Your Facebook Page ID (numeric ID)
FACEBOOK_PAGE_ID=your_facebook_page_id_here

# Your Facebook Page Access Token (long-lived, with required scopes)
FACEBOOK_PAGE_TOKEN=your_facebook_page_token_here

# ========================================
# TIKTOK CONTENT POSTING API CONFIGURATION
# ========================================

# TikTok for Developers Credentials
# Requirements:
# - TikTok Developer Account
# - Approved app with Content Posting API access
# - Required scopes: video.create, video.publish

# Your TikTok App Client Key
TIKTOK_CLIENT_KEY=your_tiktok_client_key_here

# Your TikTok App Client Secret
TIKTOK_CLIENT_SECRET=your_tiktok_client_secret_here

# TikTok Access Token (obtained via OAuth flow)
TIKTOK_ACCESS_TOKEN=your_tiktok_access_token_here

# TikTok Refresh Token (for token renewal)
TIKTOK_REFRESH_TOKEN=your_tiktok_refresh_token_here

# ========================================
# TWITTER/X API CONFIGURATION
# ========================================

# Twitter Developer Account Credentials
# Requirements:
# - Twitter Developer Account with elevated access
# - Project and App created in Twitter Developer Portal
# - Required permissions: tweet.read, tweet.write, users.read, offline.access

# Your Twitter Bearer Token (for API authentication)
TWITTER_BEARER=your_twitter_bearer_token_here

# Your Twitter API Key (Consumer Key)
TWITTER_API_KEY=your_twitter_api_key_here

# Your Twitter API Secret (Consumer Secret)
TWITTER_API_SECRET=your_twitter_api_secret_here

# Your Twitter Access Token (for user authentication)
TWITTER_ACCESS_TOKEN=your_twitter_access_token_here

# Your Twitter Access Token Secret
TWITTER_ACCESS_TOKEN_SECRET=your_twitter_access_token_secret_here

# ========================================
# YOUTUBE DATA API CONFIGURATION
# ========================================

# YouTube/Google Cloud Platform Credentials
# Requirements:
# - Google Cloud Project with YouTube Data API v3 enabled
# - OAuth 2.0 credentials created
# - Required scopes: https://www.googleapis.com/auth/youtube.upload, https://www.googleapis.com/auth/youtube.readonly

# Your YouTube API Key (for public API access)
YOUTUBE_API_KEY=your_youtube_api_key_here

# Your Google OAuth 2.0 Client ID
YOUTUBE_CLIENT_ID=your_youtube_client_id_here

# Your Google OAuth 2.0 Client Secret
YOUTUBE_CLIENT_SECRET=your_youtube_client_secret_here

# YouTube Access Token (obtained via OAuth flow)
YOUTUBE_ACCESS_TOKEN=your_youtube_access_token_here

# YouTube Refresh Token (for token renewal)
YOUTUBE_REFRESH_TOKEN=your_youtube_refresh_token_here

# ========================================
# ANALYTICS AND MONITORING
# ========================================

# Sentry DSN for error tracking (optional)
SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id

# External logging service configuration (optional)
LOGGING_SERVICE_URL=https://your-logging-service.com/api/logs

# ========================================
# DATABASE CONFIGURATION (OPTIONAL)
# ========================================

# Database URL for persistent job storage and analytics
# Examples:
# PostgreSQL: postgresql://username:password@localhost:5432/analytics_db
# MySQL: mysql://username:password@localhost:3306/analytics_db
# SQLite: sqlite:///./analytics.db

DATABASE_URL=postgresql://username:password@localhost:5432/video_uploader_db

# ========================================
# MEDIA STORAGE CONFIGURATION (OPTIONAL)
# ========================================

# AWS S3 Configuration (for media hosting)
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_S3_BUCKET=your-s3-bucket-name
AWS_REGION=us-east-1

# Cloudinary Configuration (alternative to S3)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
CLOUDINARY_URL=cloudinary://api_key:api_secret@cloud_name

# Zapier Webhook URL for publishing
ZAPIER_WEBHOOK_URL=https://hooks.zapier.com/hooks/catch/your-webhook-id/

# Profile IDs for each platform (used in Zapier payload)
YOUTUBE_PROFILE_ID=your_youtube_profile_id
INSTAGRAM_PROFILE_ID=your_instagram_profile_id
TIKTOK_PROFILE_ID=your_tiktok_profile_id
FACEBOOK_PROFILE_ID=your_facebook_profile_id
TWITTER_PROFILE_ID=your_twitter_profile_id

# ========================================
# NOTIFICATION CONFIGURATION (OPTIONAL)
# ========================================

# Slack Webhook for notifications (for human-in-the-loop features)
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/SLACK/WEBHOOK

# Email configuration for notifications (optional)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password

# ========================================
# VOICE-TO-TEXT CONFIGURATION (OPTIONAL)
# ========================================

# Voice-to-text service API configuration
# This is used for converting voice inputs to text in supported areas

# OpenAI Whisper API (if using)
OPENAI_API_KEY=your_openai_api_key

# Google Speech-to-Text (if using)
GOOGLE_SPEECH_API_KEY=your_google_speech_api_key

# AWS Transcribe (if using)
AWS_TRANSCRIBE_REGION=us-east-1

# ========================================
# RATE LIMITING AND PERFORMANCE
# ========================================

# Maximum number of concurrent uploads per platform
MAX_CONCURRENT_UPLOADS=3

# Request timeout in seconds
REQUEST_TIMEOUT=30

# Maximum video file size in MB
MAX_VIDEO_SIZE_MB=500

# Supported video formats (comma-separated)
SUPPORTED_FORMATS=mp4,mov,avi,mkv,webm

# ========================================
# SECURITY CONFIGURATION
# ========================================

# Secret key for JWT tokens (if implementing authentication)
SECRET_KEY=your-secret-key-change-this-in-production

# CORS allowed origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# API key for service authentication (optional)
API_KEY=your-api-key-for-service-authentication

# ========================================
# DEVELOPMENT SETTINGS
# ========================================

# Enable development features (set to false in production)
DEV_MODE=true

# Mock external API calls for testing (set to false in production)
MOCK_APIS=false

# Temporary directory for file uploads
TEMP_DIR=/tmp/video_uploads

# ========================================
# PRODUCTION SETTINGS
# ========================================

# Worker process configuration for production deployment
WORKERS=4
WORKER_TIMEOUT=300

# Health check endpoint configuration
HEALTH_CHECK_INTERVAL=30

# Backup configuration
BACKUP_ENABLED=true
BACKUP_INTERVAL_HOURS=24

# ========================================
# ADDITIONAL PLATFORM SETTINGS
# ========================================

# Platform-specific settings and limits

# Instagram settings
INSTAGRAM_MAX_VIDEO_SIZE_MB=100
INSTAGRAM_MAX_DURATION_SECONDS=60
INSTAGRAM_PREFERRED_RESOLUTION=1080x1920

# Facebook settings
FACEBOOK_MAX_VIDEO_SIZE_MB=4000
FACEBOOK_MAX_DURATION_SECONDS=240

# TikTok settings
TIKTOK_MAX_VIDEO_SIZE_MB=1000
TIKTOK_MAX_DURATION_SECONDS=180
TIKTOK_MIN_DURATION_SECONDS=3

# Twitter settings
TWITTER_MAX_VIDEO_SIZE_MB=512
TWITTER_MAX_DURATION_SECONDS=140

# YouTube settings
YOUTUBE_MAX_VIDEO_SIZE_MB=2000
YOUTUBE_MAX_DURATION_SECONDS=43200

# ========================================
# INTEGRATION SETTINGS
# ========================================

# Webhook URLs for external integrations
ANALYTICS_WEBHOOK_URL=https://your-analytics-service.com/webhook
MONITORING_WEBHOOK_URL=https://your-monitoring-service.com/webhook

# External API endpoints
MEDIA_HOSTING_API_URL=https://your-media-hosting-service.com/api
CDN_BASE_URL=https://your-cdn.com/

# ========================================
# FEATURE FLAGS
# ========================================

# Enable/disable specific features
ENABLE_VOICE_TO_TEXT=true
ENABLE_SCHEDULED_POSTING=true
ENABLE_ANALYTICS=true
ENABLE_HUMAN_IN_THE_LOOP=true
ENABLE_BATCH_UPLOAD=true

# ========================================
# PERFORMANCE OPTIMIZATION
# ========================================

# Caching configuration
REDIS_URL=redis://localhost:6379/0
CACHE_TTL_SECONDS=3600

# Compression settings
ENABLE_COMPRESSION=true
COMPRESSION_LEVEL=6

# Async configuration
MAX_ASYNC_WORKERS=10
ASYNC_TIMEOUT_SECONDS=300

# ========================================
# COMPLIANCE AND LEGAL
# ========================================

# Content moderation settings
ENABLE_CONTENT_MODERATION=true
MODERATION_SERVICE_URL=https://your-moderation-service.com/api

# Data retention settings (days)
ANALYTICS_RETENTION_DAYS=365
LOG_RETENTION_DAYS=90
TEMP_FILE_RETENTION_HOURS=24

# Geographic restrictions (comma-separated country codes)
ALLOWED_COUNTRIES=US,CA,UK,DE,FR,JP,AU

# ========================================
# DEBUGGING AND TESTING
# ========================================

# Enable detailed error reporting in development
DEBUG_ERROR_REPORTING=true

# Mock data for testing
MOCK_INSTAGRAM_RESPONSE=false
MOCK_FACEBOOK_RESPONSE=false
MOCK_TIKTOK_RESPONSE=false
MOCK_TWITTER_RESPONSE=false
MOCK_YOUTUBE_RESPONSE=false

# Test account IDs (for sandbox testing)
TEST_INSTAGRAM_USER_ID=test_instagram_user_id
TEST_FACEBOOK_PAGE_ID=test_facebook_page_id
TEST_TIKTOK_USER_ID=test_tiktok_user_id
TEST_TWITTER_USER_ID=test_twitter_user_id
TEST_YOUTUBE_CHANNEL_ID=test_youtube_channel_id

# ========================================
# SETUP INSTRUCTIONS
# ========================================

# TO SET UP THIS SERVICE:
#
# 1. Copy this file to .env:
#    cp .env.example .env
#
# 2. Fill in your actual API credentials for each platform
#
# 3. Set up your platform APIs:
#    - Instagram: https://developers.facebook.com/docs/instagram
#    - Facebook: https://developers.facebook.com/docs/graph-api
#    - TikTok: https://developers.tiktok.com/
#    - Twitter: https://developer.twitter.com/
#    - YouTube: https://developers.google.com/youtube
#
# 4. Test your credentials:
#    python -c "from app import app; print('Configuration loaded successfully')"
#
# 5. Start the service:
#    python -m uvicorn app:app --reload --host 0.0.0.0 --port 8000
#
# 6. Check health endpoint:
#    curl http://localhost:8000/health
#
# 7. Upload a test video:
#    curl -X POST "http://localhost:8000/upload-and-publish" \
#      -H "accept: application/json" \
#      -H "Content-Type: multipart/form-data" \
#      -F "file=@test_video.mp4" \
#      -F "platforms=[\"instagram\"]" \
#      -F "title=Test Video" \
#      -F "description=This is a test!"
#
# IMPORTANT NOTES:
# - Never commit your actual .env file to version control
# - Use strong, unique credentials for each platform
# - Regularly rotate your API keys and tokens
# - Monitor your API usage and rate limits
# - Test on sandbox accounts before production use
# - Respect each platform's Terms of Service